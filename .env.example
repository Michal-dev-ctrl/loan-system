# העתיקי לקובץ .env.local בפיתוח, או הוסיפי ב־Vercel → Settings → Environment Variables

# חובה לשליחת מייל (מ־https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxx

# אופציונלי – כתובת השולח (ברירת מחדל: onboarding@resend.dev)
# RESEND_FROM=גמ״ח אור לכלה <onboarding@resend.dev>

# לאן הקבלות נשלחות בלי דומיין מאומת — חייב להיות מייל חשבון Resend
# RECEIPT_EMAIL_TO=ms0556771200@gmail.com

# אחרי אימות דומיין ב־resend.com/domains — הפעילי שליחה לכתובת שהמשתמשת מזינה
# RECEIPT_ALLOW_CUSTOM_TO=true
# NEXT_PUBLIC_RECEIPT_ALLOW_CUSTOM_TO=true
